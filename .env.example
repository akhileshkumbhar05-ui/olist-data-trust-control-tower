# Nonsecret configuration. Do not commit a populated .env.
OLIST_BACKEND=local
OLIST_DATA_ROOT=data
DATABRICKS_CATALOG=workspace
OLIST_SCHEMA_PREFIX=olist
OLIST_VOLUME=raw
# Fill these only for authenticated Databricks operations; no tokens here.
DATABRICKS_HOST=
DATABRICKS_SQL_WAREHOUSE_ID=
# Optional for a future explicitly configured classic-compute job.
# Serverless notebooks/jobs do not have or require a cluster ID.
DATABRICKS_CLUSTER_ID=
DATABRICKS_SERVERLESS_ENVIRONMENT_VERSION=2
# Legacy OLIST_CATALOG / DATABRICKS_WAREHOUSE_ID are supported as fallbacks.
# The app receives its warehouse ID through the sql-warehouse resource.
# Use CLI OAuth / approved secure workload authentication, never source-code tokens.
# Optional writable acquisition staging; governed raw landing is separate.
# KAGGLEHUB_CACHE=/workspace/kaggle-cache
